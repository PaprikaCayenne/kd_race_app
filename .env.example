# File: .env.example
# Version: v1.1.3 | Template config for KD Race App

# PostgreSQL password for derby_admin user (raw)
DB_PASS=change_me_raw_password

# URL-encoded DB password for connection strings
# Example raw:      3K!JXoRiP3ir@7yf
# Example encoded:  3K%21JXoRiP3ir%407yf
DB_PASS_URLENC=change_me_urlencoded_password

# Secure admin password used to authorize /api/admin endpoints
API_ADMIN_PASS=change_me_admin_password

# Prevent Prisma from trying to install client at runtime
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# Docker UID/GID for proper file ownership from kd_frontend_builder
PUID=1000
PGID=1000

# Note:
# DATABASE_URL is dynamically constructed in docker-compose.yml
# Format: postgres://derby_admin:${DB_PASS_URLENC}@192.168.50.209:5432/derby
